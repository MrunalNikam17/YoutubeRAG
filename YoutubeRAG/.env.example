# Application identity and runtime
APP_NAME=AI YouTube Video Chatbot
ENVIRONMENT=development

# Groq-compatible chat model (required for answering questions)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hugging Face (optional; embeddings are downloaded from the configured model)
HUGGINGFACEHUB_API_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Extension/backend URL and local cache locations
BACKEND_URL=http://127.0.0.1:8000
DATA_DIR=./data
TRANSCRIPT_CACHE_DIR=./data/transcripts
VECTORSTORE_DIR=./data/vectorstores

# Retrieval, transcript batching, and chat limits
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
RETRIEVAL_MODE=vector
RETRIEVAL_CANDIDATE_K=20
RERANK_ENABLED=false
RERANK_CANDIDATE_K=20
MAX_QUESTION_CHARS=2000
MAX_HISTORY_MESSAGES=8
MAX_TRANSCRIPT_CHARS_PER_BATCH=3500
SUMMARY_SECTION_SECONDS=600

# Browser access. ALLOWED_ORIGINS is comma-separated; valid Chrome extension IDs are allowed in development.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOW_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$

# Per-client request limit for /api/chat and /api/video/load; 0 disables limiting.
RATE_LIMIT_PER_MINUTE=60

# Transcript language selection, comma-separated
TRANSCRIPT_LANGUAGE_PREFERENCES=en,hi

# Optional speech-to-text fallback for videos without usable captions
WHISPER_FALLBACK_ENABLED=false
WHISPER_MODEL=base
MAX_VIDEO_MINUTES=30

# Optional API authentication; an empty value disables API-key checks
API_KEY=

# SQLite chat-history storage location
CHAT_HISTORY_DB_PATH=./data/chat_history.sqlite3
